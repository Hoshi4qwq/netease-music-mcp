# NetEase Cloud Music Cookie
# Recommended: paste the WHOLE Cookie header (F12 -> Network -> any music.163.com request
# -> Request Headers -> Cookie). It must contain MUSIC_U and __csrf. A MUSIC_U-only cookie
# may be rejected by playlist create/update with "403 illegal request".
NETEASE_COOKIE=MUSIC_U=your_music_u_here; __csrf=your_csrf_here

# Optional: set the csrf separately (it is added to the Cookie header automatically)
# NETEASE_CSRF=

# Optional: timezone of timestamps in tool output, in hours (Beijing = 8). Default: UTC
# NETEASE_TZ_OFFSET=8

# MCP Server Port
MCP_PORT=3456
